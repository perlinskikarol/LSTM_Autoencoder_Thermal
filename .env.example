HIK_IP=192.168.0.100
HIK_USER=your_camera_user
HIK_PASS=your_camera_password
RTSP_PORT=554
RTSP_RGB=
RTSP_TH=
CHANNEL_ID_FOR_METADATA=2
ENABLE_METADATA=false
# Modes: legacy | auto | http_thermal | http_thermal_p2p
METADATA_MODE=http_thermal_p2p
METADATA_LEGACY_URI=
METADATA_HTTP_ENDPOINT=
METADATA_RETRY_SEC=20
METADATA_AUTH_LOCKOUT_SEC=1200
METADATA_MAX_AUTH_FAILURES=1
# Legacy alias for raw CSV path (used if RAW_CSV_PATH is empty):
FOREHEAD_CSV_PATH=logs/forehead_raw.csv
RAW_CSV_PATH=logs/forehead_raw.csv
AGG_CSV_PATH=logs/forehead_aggregated.csv
SAMPLE_PERIOD_SEC=1.0
AGG_WINDOW_SEC=60
AGG_EMIT_SEC=5
MEDIAN_WINDOW=5
EWMA_ALPHA=0.2
ROI_MATCH_MIN_IOU=0.15
STRICT_ROI_ONLY=true
MP_MIN_DETECTION_CONF=0.60
MP_MODEL_SELECTION=1
MP_DETECTION_INPUT_SCALE=1.5
MP_FACE_MODEL_PATH=
MP_FACE_TOP_EXPAND_RATIO=0.35
TEMP_PROPERTY=average
P2P_TEMP_MIN_C=32.0
P2P_TEMP_MAX_C=43.5
P2P_TRIM_LOW_PCT=5.0
P2P_TRIM_HIGH_PCT=5.0
P2P_MIN_VALID_PIXELS=25
# Optional calibrated homography matrix (RGB->THERMAL), 9 comma-separated values:
# RGB_TO_THERMAL_H=1,0,0,0,1,0,0,0,1
# Compute this using:
# python -m src.calibrate_homography
# Optional distance-aware homography switching (uses face size in RGB for hysteresis):
HOMOGRAPHY_SWITCH_ENABLED=false
RGB_TO_THERMAL_H_NEAR=
RGB_TO_THERMAL_H_FAR=
HOMOGRAPHY_NEAR_MIN_FACE_WIDTH_RATIO=0.32
HOMOGRAPHY_FAR_MAX_FACE_WIDTH_RATIO=0.24
# If thermal camera has narrower FOV than RGB, set coverage < 1.0 (central crop model).
# Example: THERMAL_COVERAGE_X=0.78 means thermal sees central 78% of RGB width.
THERMAL_COVERAGE_X=1.0
THERMAL_COVERAGE_Y=1.0
# Optional manual correction after mapping RGB ROI -> Thermal ROI:
# positive X shifts ROI to the right, positive Y shifts ROI down.
THERMAL_ROI_SHIFT_X_RATIO=0.0
THERMAL_ROI_SHIFT_Y_RATIO=0.0
THERMAL_ROI_SCALE_X=1.0
THERMAL_ROI_SCALE_Y=1.0
# Dynamic update of camera thermometry region (ISAPI PUT /ISAPI/Thermal/channels/<CHANNEL_ID_FOR_METADATA>/thermometry/<scene>).
# This makes camera-side region follow mapped forehead ROI.
DYNAMIC_THERMOMETRY_REGION_ENABLED=false
DYNAMIC_THERMOMETRY_SCENE_ID=1
DYNAMIC_THERMOMETRY_REGION_ID=1
DYNAMIC_THERMOMETRY_UPDATE_SEC=2.0
DYNAMIC_THERMOMETRY_MIN_MOVE_NORM=0.03
DYNAMIC_THERMOMETRY_MAX_FAILURES=1
DYNAMIC_THERMOMETRY_FAILURE_BACKOFF_SEC=10.0
